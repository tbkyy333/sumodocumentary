{
  "name": "dohyougiwa-static",
  "version": "1.0.0",
  "private": true,
  "description": "Static HTML site for 土俵際 (framework-free).",
  "scripts": {
    "build:css": "tailwindcss -i ./tailwind-input.css -o ./styles.css --minify",
    "watch:css": "tailwindcss -i ./tailwind-input.css -o ./styles.css --watch",
    "serve": "python3 -m http.server 4000 --bind 127.0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11"
  }
}
